---
import { Picture, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';
import { type Lang } from '../i18n/routes';
import { t } from '../i18n';

interface Props { entry: CollectionEntry<'work'>; lang: Lang; tone?: 'bg' | 'surface'; first?: boolean }
const { entry, lang, tone = 'bg', first = false } = Astro.props;
const d = entry.data;
const tr = t(lang).workPage;

// The lightest brand colour makes the backdrop for the logo tile.
const lum = (hex: string) => {
  const n = parseInt(hex.slice(1), 16);
  return 0.2126 * ((n >> 16) & 255) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255);
};
const logoBg = [...d.colors].sort((a, b) => lum(b.hex) - lum(a.hex))[0]?.hex ?? '#fff';

// Screens load on demand (see script): build avif/webp srcsets up to the source width, never upscaled.
const SCREEN_SIZES = '(min-width: 1280px) 1152px, 100vw';
const screens = await Promise.all(d.screens.map(async (s) => {
  if (!s.image) return null;
  const src = s.image;
  const widths = [...new Set([800, 1200, src.width].filter((w) => w <= src.width))].sort((a, b) => a - b);
  const srcset = async (format: 'avif' | 'webp') =>
    (await Promise.all(widths.map(async (width) => `${(await getImage({ src, width, format })).src} ${width}w`))).join(', ');
  const fallback = await getImage({ src, width: widths[widths.length - 1], format: 'webp' });
  return { alt: s.alt[lang], width: src.width, height: src.height, avif: await srcset('avif'), webp: await srcset('webp'), fallback: fallback.src };
}));
const meta = [
  { label: tr.brief, text: d.brief[lang] },
  { label: tr.audience, text: d.audience[lang] },
  { label: tr.decisions, text: d.decisions[lang] },
];
---
<article class:list={['case', `tone-${tone}`]} id={entry.id}>
  <div class="container inner">
    <div class="hero">
      {d.hero && (
        <Picture src={d.hero} alt={d.heroAlt[lang]} widths={[640, 1024, 1400]} sizes="(min-width: 1280px) 1152px, 100vw" formats={['avif', 'webp']} loading={first ? 'eager' : 'lazy'} fetchpriority={first ? 'high' : 'auto'} class="hero-img" pictureAttributes={{ class: 'hero-wrap' }} />
      )}
      {d.concept && <Tag class="tag-pos">{tr.tag}</Tag>}
    </div>

    <div class="title-row">
      <h2 class="wide">{d.title}</h2>
      <span class="type">{d.type[lang]}</span>
    </div>

    <dl class="meta">
      {meta.map((m) => <div><dt>{m.label}</dt><dd>{m.text}</dd></div>)}
    </dl>

    <div class="style">
      <div class="style-col">
        <h3 class="eyebrow">{tr.colors}</h3>
        <ul class="swatches">
          {d.colors.map((c) => (
            <li class="sw"><span style={`background:${c.hex}`}></span><span>{c.label ?? c.hex}</span></li>
          ))}
        </ul>
      </div>
      <div class="style-col">
        <h3 class="eyebrow">{d.logo ? tr.typeLogo : tr.type}</h3>
        <div class="type-tiles">
          {d.logo && (
            <div class="logo-tile" style={`background:${logoBg}`}>
              {d.logo.format === 'svg'
                ? <img src={d.logo.src} alt={d.title} width={d.logo.width} height={d.logo.height} loading="lazy" class="logo-svg" />
                : <Picture src={d.logo} alt={d.title} widths={[240, 480]} sizes="240px" formats={['webp']} loading="lazy" />}
            </div>
          )}
          <div class="font-tile"><span class="aa">Aa</span><span class="font-name">{d.font}</span></div>
        </div>
      </div>
    </div>

    <div class="final">
      <h3 class="eyebrow">{tr.final}</h3>
      <div class="screens">
        {screens.map((s) => s && (
          <div class="screen">
            <picture data-lazy-picture>
              <source type="image/avif" data-srcset={s.avif} sizes={SCREEN_SIZES} />
              <source type="image/webp" data-srcset={s.webp} sizes={SCREEN_SIZES} />
              <img alt={s.alt} width={s.width} height={s.height} decoding="async" data-fallback={s.fallback} />
            </picture>
            <noscript><img src={s.fallback} alt={s.alt} width={s.width} height={s.height} /></noscript>
          </div>
        ))}
      </div>
    </div>
  </div>
</article>

<style>
  .case { padding-block: 0 var(--section-y); }
  .tone-surface { background: var(--surface); padding-block: var(--section-y); }
  .inner { display: flex; flex-direction: column; gap: 40px; }

  .hero { position: relative; overflow: hidden; background: var(--surface-2); }
  .hero :global(.hero-wrap) { display: block; }
  .hero :global(.hero-img) { display: block; width: 100%; height: auto; }
  .hero :global(.tag-pos) { position: absolute; top: 16px; left: 16px; padding: 7px 11px; }
  @media (min-width: 820px) { .hero :global(.tag-pos) { top: 20px; left: 20px; } }

  .title-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; }
  h2 { margin: 0; font-size: clamp(30px, 3.6vw, 52px); font-weight: 700; }
  .type { font-size: 15px; color: var(--muted); }

  .meta {
    margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 32px;
    padding: 32px 0; border-block: 1px solid var(--line);
  }
  dt { font-size: 11px; font-weight: 600; font-stretch: 125%; text-transform: uppercase; letter-spacing: .14em; color: var(--muted); margin-bottom: 10px; }
  dd { margin: 0; font-size: 16px; line-height: 1.55; color: var(--text-2); }

  .style { display: flex; flex-wrap: wrap; gap: 40px; }
  .style-col { flex: 1 1 360px; display: flex; flex-direction: column; gap: 16px; }
  h3 { margin: 0; }
  .swatches { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(72px, 1fr)); gap: 10px; }
  .sw { display: flex; flex-direction: column; gap: 8px; font-size: 12px; color: var(--muted); }
  .sw span:first-child { height: 72px; border: 1px solid rgba(255, 255, 255, .12); }
  .type-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
  .logo-tile { min-height: 112px; display: flex; align-items: center; justify-content: center; padding: 20px; }
  .logo-tile :global(img) { height: auto; width: auto; max-height: 72px; max-width: 100%; object-fit: contain; }
  .logo-tile :global(img.logo-svg) { width: 100%; max-width: 200px; max-height: none; }
  .font-tile { min-height: 112px; border: 1px solid var(--line); display: flex; flex-direction: column; justify-content: center; padding: 16px; gap: 4px; }
  .aa { font-size: 30px; }
  .font-name { font-size: 12px; color: var(--muted); }

  .final { display: flex; flex-direction: column; gap: 16px; }
  .screens { display: grid; grid-template-columns: 1fr; gap: 24px; }
  .screen { background: var(--surface-2); }
  .screen picture { display: block; }
  .screen :global(img) { display: block; width: 100%; height: auto; }
  /* Fade in once the image has loaded and scrolled into view. */
  :global(html:not(.no-js)) .screen picture { opacity: 0; transform: translateY(28px); transition: opacity .7s ease-out, transform .7s ease-out; }
  :global(html:not(.no-js)) .screen picture.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    :global(html:not(.no-js)) .screen picture { transform: none; transition: none; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const pics = Array.from(document.querySelectorAll<HTMLElement>('picture[data-lazy-picture]'));
    if (!pics.length) return;

    // Nothing is fetched until the picture is close to the viewport.
    const loader = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const pic = e.target as HTMLElement;
        loader.unobserve(pic);
        pic.querySelectorAll<HTMLSourceElement>('source[data-srcset]').forEach((s) => { s.srcset = s.dataset.srcset!; });
        const img = pic.querySelector<HTMLImageElement>('img')!;
        const done = () => { pic.dataset.loaded = '1'; reveal(pic); };
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', done, { once: true });
        img.src = img.dataset.fallback!;
      }
    }, { rootMargin: '300px 0px' });

    // Fade in when scrolled into view, and only after the file has arrived.
    const seen = new WeakSet<Element>();
    const shown = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { seen.add(e.target); shown.unobserve(e.target); reveal(e.target as HTMLElement); }
    }, { rootMargin: '0px 0px -12% 0px' });
    const reveal = (pic: HTMLElement) => {
      if (pic.dataset.loaded && seen.has(pic)) pic.classList.add('is-in');
    };

    pics.forEach((p) => { loader.observe(p); shown.observe(p); });
  });
</script>
