---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from './Button.astro';
import { path, type Lang } from '../i18n/routes';
import { t } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang).thanks;
---
<BaseLayout lang={lang} routeId="thanks" title={tr.title} description={tr.description} noindex>
  <div class="container wrap">
    <div class="box">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>
      <div>
        <h1 class="wide">{tr.heading}</h1>
        <p>{tr.audit}</p>
        <p>{tr.contact}</p>
      </div>
    </div>
    <Button href={path('home', lang)} variant="secondary">{tr.home}</Button>
  </div>
</BaseLayout>

<style>
  .wrap { padding-block: var(--section-y); display: flex; flex-direction: column; gap: 32px; align-items: flex-start; }
  .box { display: flex; gap: 16px; align-items: flex-start; padding: 24px; border: 1px solid var(--accent); max-width: 560px; }
  svg { flex: none; color: var(--accent); margin-top: 4px; }
  h1 { margin: 0 0 12px; font-size: 28px; font-weight: 700; }
  p { margin: 0 0 8px; color: var(--text-2); }
</style>
