---
interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email' | 'url';
  textarea?: boolean;
  required?: boolean;
  placeholder?: string;
  autocomplete?: string;
  inputmode?: 'text' | 'email' | 'url';
  class?: string;
}
const {
  id, name, label, type = 'text', textarea = false, required = false,
  placeholder, autocomplete, inputmode, class: cls = '',
} = Astro.props;
---
<div class:list={['field', cls]}>
  <label for={id}>{label}</label>
  {textarea ? (
    <textarea id={id} name={name} required={required} rows="5" autocomplete={autocomplete} aria-describedby={`${id}-err`}></textarea>
  ) : (
    <input
      id={id} name={name} type={type} required={required} placeholder={placeholder}
      autocomplete={autocomplete} inputmode={inputmode} aria-describedby={`${id}-err`}
    />
  )}
  <span id={`${id}-err`} class="err" hidden></span>
</div>

<style>
  .field { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  label {
    font-size: 12px; font-weight: 600; font-stretch: 112%; line-height: 1;
    letter-spacing: .1em; text-transform: uppercase; color: var(--text-3);
  }
  input, textarea {
    width: 100%; min-height: 52px; padding: 0 16px;
    border: 1px solid var(--line); border-radius: var(--radius-control);
    background: var(--bg); color: #fff; font: 400 16px var(--font);
  }
  textarea { padding: 14px 16px; min-height: 120px; resize: vertical; }
  input::placeholder { color: var(--placeholder); }
  input:focus-visible, textarea:focus-visible { border-color: var(--accent); outline-offset: 1px; }
  .field:has([aria-invalid='true']) :is(input, textarea) { border-color: var(--error); }
  .err { font-size: 13px; color: var(--error); }
</style>
