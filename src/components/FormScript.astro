<script>
  // Progressive enhancement for .audit-form / .contact-form. Without JS the form does a
  // normal POST to the PHP script, which redirects to the thanks page.
  type Control = HTMLInputElement | HTMLTextAreaElement;

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-form-wrap]').forEach((wrap) => {
      const form = wrap.querySelector<HTMLFormElement>('form');
      const status = wrap.querySelector<HTMLElement>('[data-form-status]');
      if (!form || !status) return;

      const stamp = form.querySelector<HTMLInputElement>('[data-ts]');
      if (stamp) stamp.value = String(Date.now());

      form.noValidate = true; // we show our own Dutch/English messages
      const msg = (key: string) => form.dataset[key] ?? '';
      const controls = () =>
        Array.from(form.querySelectorAll<Control>('input, textarea')).filter(
          (el) => el.type !== 'hidden' && el.name !== 'company',
        );

      const setError = (el: Control, text: string) => {
        const out = document.getElementById(`${el.id}-err`);
        if (out) {
          out.textContent = text;
          out.hidden = !text;
        }
        if (text) el.setAttribute('aria-invalid', 'true');
        else el.removeAttribute('aria-invalid');
      };

      // "bakkerij.be" is accepted: add the scheme before the browser validates it.
      const normalise = (el: Control) => {
        el.value = el.value.trim();
        if (el.type === 'url' && el.value && !/^[a-z][a-z0-9+.-]*:\/\//i.test(el.value)) {
          el.value = `https://${el.value}`;
        }
      };

      const validUrlHost = (value: string) => {
        try {
          return new URL(value).hostname.includes('.');
        } catch {
          return false;
        }
      };

      const validate = (): Control | null => {
        let first: Control | null = null;
        for (const el of controls()) {
          el.setCustomValidity('');
          if (el.type !== 'checkbox') normalise(el);
          let text = '';
          const v = el.validity;
          if (v.valueMissing) text = el.type === 'checkbox' ? msg('errPrivacy') : msg('errRequired');
          else if (v.typeMismatch || v.badInput) text = el.type === 'email' ? msg('errEmail') : msg('errUrl');
          else if (el.type === 'url' && el.value && !validUrlHost(el.value)) text = msg('errUrl');
          el.setCustomValidity(text);
          setError(el, text);
          if (text && !first) first = el;
        }
        return first;
      };

      controls().forEach((el) => {
        el.addEventListener('input', () => {
          el.setCustomValidity('');
          setError(el, '');
        });
      });

      const show = (kind: 'success' | 'error') => {
        status.querySelectorAll<HTMLElement>('[data-status]').forEach((box) => {
          box.hidden = box.dataset.status !== kind;
        });
        if (kind === 'success') form.hidden = true;
        status.focus();
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const invalid = validate();
        if (invalid) {
          invalid.focus();
          return;
        }
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const label = button?.textContent ?? '';
        if (button) {
          button.disabled = true;
          button.textContent = msg('sending');
        }
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          const data = await response.json().catch(() => null);
          show(response.ok && data && data.ok ? 'success' : 'error');
        } catch {
          show('error');
        } finally {
          if (button) {
            button.disabled = false;
            button.textContent = label;
          }
        }
      });
    });
  });
</script>
