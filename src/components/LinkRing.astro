---
interface Props { href: string; class?: string }
const { href, class: cls = '' } = Astro.props;
---
<a href={href} class:list={['link-ring', cls]}>
  <span class="ring">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </span>
  <span class="label wide"><slot /></span>
</a>

<style>
  .link-ring { display: inline-flex; align-items: center; gap: 16px; }
  .ring {
    width: 52px; height: 52px; flex: none; border-radius: var(--radius-pill);
    border: 1.5px solid #fff; display: inline-flex; align-items: center; justify-content: center;
    transition: border-color .15s ease;
  }
  .link-ring:hover .ring { border-color: var(--accent); }
  .label { font-size: 14px; font-weight: 600; }
</style>
