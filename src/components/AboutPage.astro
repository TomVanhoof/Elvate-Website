---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from './Section.astro';
import Eyebrow from './Eyebrow.astro';
import PhotoPanel from './PhotoPanel.astro';
import Button from './Button.astro';
import { path, type Lang } from '../i18n/routes';
import { t } from '../i18n';
import portrait from '../assets/photos/portrait.jpg';
import about1 from '../assets/photos/about-1.jpg';
import about2 from '../assets/photos/tom-vanhoof-flKeOpk6f_Q-unsplash.jpg';
import about3 from '../assets/photos/tom-vanhoof-jHaGJ080Do0-unsplash.jpg';
import ctaBg from '../assets/photos/hero.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t(lang).aboutPage;
const strip = [about1, about2, about3];
---
<BaseLayout lang={lang} routeId="about" title={p.title} description={p.description}>
  <header class="container intro">
    <PhotoPanel class="portrait" image={portrait} alt={p.photoAlt} position="50% 30%" sizes="(min-width: 820px) 45vw, 100vw" widths={[640, 960, 1280, 1800]} eager scrim="transparent" />
    <div class="intro-copy">
      <Eyebrow text={p.eyebrow} />
      <h1 class="wide">{p.h1}</h1>
      <p class="lead">{p.intro}</p>
    </div>
  </header>

  <Section tone="surface" gap="0">
    <div class="drive">
      <Eyebrow as="h2" number="01" text={p.drive.eyebrow} class="drive-eyebrow" />
      <div class="drive-text">
        {p.drive.paras.map((para) => <p>{para}</p>)}
      </div>
    </div>
  </Section>

  <section class="strip" aria-label={p.stripLabel}>
    {strip.map((img, i) => (
      <div class="tile">
        <a href="https://unsplash.com/@tomvh4" target="_blank" rel="noopener noreferrer">
          <Picture src={img} alt={p.stripAlts[i]} widths={[480, 800]} sizes="(min-width: 820px) 33vw, 100vw" formats={['avif', 'webp']} loading="lazy" />
        </a>
      </div>
    ))}
  </section>

  <Section gap="0">
    <div class="how">
      <div class="how-head">
        <Eyebrow number="02" text={p.how.eyebrow} />
        <h2 class="wide">{p.how.title}</h2>
      </div>
      <ol class="rows">
        {p.how.items.map((it, i) => (
          <li><span class="n wide">{String(i + 1).padStart(2, '0')}</span><strong>{it.title}</strong><span class="txt">{it.text}</span></li>
        ))}
      </ol>
    </div>
  </Section>

  <PhotoPanel as="section" class="cta" image={ctaBg} alt="" scrim="rgba(8,10,12,.55)" widths={[640, 1024, 1600]} sizes="100vw">
    <div class="cta-inner">
      <p class="cta-title wide">{p.cta.title}</p>
      <div class="cta-actions">
        <Button href={path('audit', lang)} class="big">{p.cta.audit}</Button>
        <Button href={path('contact', lang)} variant="secondary" class="big">{p.cta.contact}</Button>
      </div>
    </div>
  </PhotoPanel>
</BaseLayout>

<style>
  .intro { padding-block: clamp(32px, 7vw, 112px); display: flex; flex-wrap: wrap; gap: clamp(32px, 6vw, 96px); align-items: flex-end; }
  .intro :global(.portrait) { flex: 1 1 360px; min-height: clamp(420px, 44vw, 640px); }
  .intro-copy { flex: 1.2 1 440px; display: flex; flex-direction: column; gap: 28px; }
  h1 { margin: 0; font-size: clamp(32px, 4.4vw, 64px); line-height: 1.04; font-weight: 700; }
  .lead { margin: 0; font-size: 20px; line-height: 1.55; color: #E1E6E8; }

  .drive { display: flex; flex-wrap: wrap; gap: 48px; }
  :global(.drive-eyebrow) { flex: 1 1 260px; }
  .drive-text { flex: 2 1 560px; display: flex; flex-direction: column; gap: 22px; font-size: 19px; line-height: 1.7; color: var(--text-2); }
  .drive-text p { margin: 0; }

  .strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 4px; padding-block: 4px; }
  .tile { height: 360px; overflow: hidden; background: var(--surface-2); }
  .tile a { display: block; width: 100%; height: 100%; }
  .tile :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .how { display: flex; flex-wrap: wrap; gap: 48px; }
  .how-head { flex: 1 1 260px; display: flex; flex-direction: column; gap: 20px; }
  .how-head h2 { margin: 0; font-size: clamp(24px, 2.6vw, 36px); line-height: 1.1; font-weight: 700; }
  .rows { flex: 2 1 560px; list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .rows li { display: flex; flex-wrap: wrap; gap: 8px 32px; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .n { flex: 0 0 48px; font-size: 14px; font-weight: 700; color: var(--accent); }
  .rows strong { flex: 0 0 220px; font-size: 19px; }
  .txt { flex: 1 1 240px; font-size: 16px; line-height: 1.55; color: var(--text-3); }

  :global(.cta) { padding: clamp(80px, 10vw, 160px) var(--gutter); justify-content: center; }
  .cta-inner { max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 28px; text-align: center; }
  .cta-title { margin: 0; font-size: clamp(26px, 3.4vw, 48px); line-height: 1.1; font-weight: 700; }
  .cta-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .cta-actions :global(.big) { min-height: 56px; }
</style>
